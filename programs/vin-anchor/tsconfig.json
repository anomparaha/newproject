{
  "compilerOptions": {
    "lib": [
      "es2020"
    ],
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "mocha",
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "target/types/**/*.ts"
  ]
}
