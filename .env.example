# --- API (services/api) ---
PORT=8080
HOST=0.0.0.0

# Location of the demo database (SQLite). Switch to Postgres in production.
# VIN_DB_PATH=/var/lib/vin/vin.db

# Turn off demo endpoints, the x-actor-id header and the simulated clock in production.
# With VIN_DEMO_MODE=false every write needs a signature-backed session token.
VIN_DEMO_MODE=true

# --- Sign-In With Solana (services/api/src/auth.ts) ---
# Domain shown inside the signed message. Leave unset to use the request Host.
# VIN_AUTH_DOMAIN=app.example.com
# VIN_AUTH_URI=https://app.example.com
# Chain ID inside the signed message (the program is not deployed; localnet is honest).
VIN_SOLANA_CHAIN_ID=solana:localnet

# --- Web (apps/web) ---
# Target of the /api/* rewrite. The browser never calls this address directly.
VIN_API_URL=http://127.0.0.1:8080

# --- Solana (not active yet; fill in after the program is deployed) ---
# VIN_ESCROW_PROGRAM_ID=
# VIN_RPC_URL=https://devnet.helius-rpc.com/?api-key=
# VIN_USDC_MINT=
# VIN_RELAYER_KEYPAIR=           # JANGAN commit. Gunakan secret manager.
# VIN_ARBITER_PUBKEY=
# Squads multisig, never a single wallet

# --- Licensed payment/escrow provider (production) ---
# VIN_ESCROW_PROVIDER=mock       # mock | licensed_custodian | anchor_solana
# VIN_ESCROW_API_KEY=

# --- Evidence storage (photos & raw reports, off-chain) ---
# VIN_EVIDENCE_BUCKET=
# VIN_EVIDENCE_REGION=
