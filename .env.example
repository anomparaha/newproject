# --- API (services/api) ---
PORT=8080
HOST=0.0.0.0

# Lokasi basis data demo (SQLite). Di produksi ganti ke Postgres.
# VIN_DB_PATH=/var/lib/vin/vin.db

# Matikan endpoint demo & waktu simulasi di produksi.
VIN_DEMO_MODE=true

# --- Web (apps/web) ---
# Tujuan rewrite /api/* . Browser TIDAK memanggil alamat ini secara langsung.
VIN_API_URL=http://127.0.0.1:8080

# --- Solana (belum aktif; isi setelah program di-deploy) ---
# VIN_ESCROW_PROGRAM_ID=
# VIN_RPC_URL=https://devnet.helius-rpc.com/?api-key=
# VIN_USDC_MINT=
# VIN_RELAYER_KEYPAIR=           # JANGAN commit. Gunakan secret manager.
# VIN_ARBITER_PUBKEY=
# VIN_ADMIN_MULTISIG=            # Squads multisig, bukan dompet tunggal

# --- Penyedia pembayaran/escrow berizin (produksi) ---
# VIN_ESCROW_PROVIDER=mock       # mock | licensed_custodian | anchor_solana
# VIN_ESCROW_API_KEY=

# --- Storage bukti (foto & laporan mentah, off-chain) ---
# VIN_EVIDENCE_BUCKET=
# VIN_EVIDENCE_REGION=
